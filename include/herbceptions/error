#include <concepts>
#include <cstddef>
#include <cstdint>
#include <type_traits>
// for ::std::errc
// avoid include system_error as much as we can to reduce compile time; the
// legacy-EH fallback is std::cxx_std_error_legacy_exception, which only
// needs <exception> on top of the errc enum.
#if defined(_LIBCPP_VERSION) && __has_include(<__system_error/errc.h>)
#include <__system_error/errc.h>
#include <cerrno>
#elif defined(__GLIBCXX__) && __has_include(<bits/error_constants.h>)
#include <bits/error_constants.h>
#elif defined(_MSVC_STL_UPDATE) && __has_include(<xerrc.h>)
#include <xerrc.h>
