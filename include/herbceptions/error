/*
Legacy-EH boxing support: __cxa_error_query_information_* back the cached
what() buffer of ::std::cxx_std_error_legacy_exception. create() drives the
domain's do_query_information hook and returns a freshly allocated,
NUL-terminated scatter (the NUL pad covers every supported encoding); clone()
duplicates such a buffer; free() releases it. The buffer lives inside the
runtime's allocator so clone/free stay correct across module/CRT
boundaries.
*/
__HERBCEPTIONS_API_ALLOC
::std::io_scatter_t __cxa_error_query_information_create(
    ::std::error_domain_singleton const *__domain, ::std::size_t __code,
    ::std::error_reporter_encoding __encoding,
    ::std::error_query_information __info) noexcept;

__HERBCEPTIONS_API_ALLOC
::std::io_scatter_t
__cxa_error_query_information_clone(void const *__base,
                                    ::std::size_t __len) noexcept;

__HERBCEPTIONS_API_ALLOC
void __cxa_error_query_information_free(void const *__base,
                                        ::std::size_t __len) noexcept;

} // extern "C"

// Values for the first (flags) parameter of
// __cxa_error_code_{itanium,msvc}_exception_ptr: 0 clones an existing
// code, 1 is the legacy in-flight conversion emitted by the compiler's
// fabricated catch site, 2 is the direct conversion emitted by the
// herbceptions-legacy-eh-fold pass for a `throw` whose unwind edge
// provably reaches only that conversion site (no exception is ever
// raised; the remaining arguments carry the __cxa_throw /
// _CxxThrowException operands). Other values abort.
extern "C" {
#ifdef _MSC_VER
__HERBCEPTIONS_API ::std::error_domain_singleton const *
__cxa_error_domain_msvc_exception_ptr() noexcept;
// flags==1: box the in-flight exception (__ExceptionPtrCurrentException).
// flags==2: box (obj, _ThrowInfo*) exactly like __ExceptionPtrCopyException.
// flags==0: __ExceptionPtrCopy an existing exception_ptr box (obj = &ep).
__HERBCEPTIONS_API ::std::size_t
__cxa_error_code_msvc_exception_ptr(::std::size_t, void const *,
                                    void const *) noexcept;
// dynamic_cast-style probe on the boxed exception without rethrowing it:
// __code must belong to the msvc exception_ptr domain and __ti must point
// at the type_info of the requested type. Matches the thrown object's
// catchable types by decorated RTTI name and returns the adjusted subobject
// pointer for *__ti; nullptr when there is no match.
__HERBCEPTIONS_API void *__cxa_error_code_msvc_exception_ptr_cast(
    ::std::error_domain_singleton const *__domain, ::std::size_t __code,
    void const *__ti) noexcept;
// Copies a boxed exception code into the caller's std::exception_ptr
// storage (__epstorage must point to sizeof(std::exception_ptr) bytes),
// retaining the reference. __code must belong to the msvc exception_ptr
// domain.
__HERBCEPTIONS_API_ALLOC void
__cxa_error_code_msvc_exception_ptr_unbox(void *__epstorage,
                                          ::std::size_t __code) noexcept;
#else
__HERBCEPTIONS_API ::std::error_domain_singleton const *
__cxa_error_domain_itanium_exception_ptr() noexcept;
// flags==1: eh is the in-flight _Unwind_Exception* (wasm.get.exception /
// landing pad exn). flags==2: eh/tinfo/dtor are the __cxa_throw operands;
// initializes the primary-exception header without raising and holds the
// flight reference as an owned refcount. flags==0: eh is an existing
// exception code to retain.
__HERBCEPTIONS_API ::std::size_t
__cxa_error_code_itanium_exception_ptr(::std::size_t, void *, void *,
                                       void *) noexcept;
// dynamic_cast-style probe on the boxed exception without rethrowing it:
// __code must belong to the itanium exception_ptr domain and __ti must
// point at the type_info of the requested type. Runs the runtime's own
// catch matcher (__do_catch) against *__ti and returns the adjusted
// subobject pointer; nullptr when there is no match.
__HERBCEPTIONS_API void *__cxa_error_code_itanium_exception_ptr_cast(
    ::std::error_domain_singleton const *__domain, ::std::size_t __code,
    void const *__ti) noexcept;
#endif

} // extern "C"
#undef __HERBCEPTIONS_API
#undef __HERBCEPTIONS_API_ALLOC
#pragma pop_macro("__HERBCEPTIONS_API_ALLOC")
#pragma pop_macro("__HERBCEPTIONS_API")
} // namespace error_domains

template <typename __Other>
  requires(::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
constexpr bool operator==(::std::error const &__ec,
                          __Other const &__other) noexcept {
  using __other_error_domain_type = ::std::error_domain<__Other>;
  if constexpr (::std::__details::__error_domain_has_domain_alias_type<
                    __other_error_domain_type>) {
    using __other_domain_alias_type =
        typename __other_error_domain_type::domain_alias_type;
    return __other_error_domain_type::code(__other) == __ec.code() &&
           __other_domain_alias_type::domain() == __ec.domain();
  } else {
    return __other_error_domain_type::code(__other) == __ec.code() &&
           __other_error_domain_type::domain() == __ec.domain();
  }
}

template <typename __Other>
  requires(::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
constexpr bool operator==(__Other const __other,
                          ::std::error const &__e) noexcept {
  return __e == __other;
}

template <typename __Other>
  requires requires(::std::error __e) {
    {
      ::std::error_domain<__Other>::from_std_error(__e)
    } -> std::same_as<__Other>;
  }
constexpr auto herbception_cast(::std::error const &__e) noexcept {
  using __other_error_domain_type = ::std::error_domain<__Other>;
  return __other_error_domain_type::from_std_error(__e);
}

// ---------------------------------------------------------------------------
// Herbception type traits.
//
// These are thin wrappers over the compiler's `__is_herbceptions_*` /
// `__has_herbceptions_*` builtins (available under -fherbceptions), providing
// standard-library-style trait variable templates. They test the `throws`
// channel (implicit std::error); there are no `return_failure{E}` variants
// because return_failure{E} is a C-style feature restricted to free functions.
// ---------------------------------------------------------------------------
#if defined(__HERBCEPTIONS__)
template <typename __T>
inline constexpr bool is_herbceptions_throwsable_v =
    __is_herbceptions_throwsable(__T);

template <typename __T>
struct is_herbceptions_throwsable
    : ::std::bool_constant<::std::is_herbceptions_throwsable_v<__T>> {};

template <typename __F>
inline constexpr bool is_invoke_herbceptions_return_failure_v =
    __is_invoke_herbceptions_return_failure(__F);

template <typename __F>
struct is_invoke_herbceptions_return_failure
    : ::std::bool_constant<
          ::std::is_invoke_herbceptions_return_failure_v<__F>> {};

// __invoke_herbceptions_return_failure_result<F> yields a synthetic struct with
// value_type (the success return type) and error_type (the return_failure{E}
// error type, void when F is not a return_failure function). Query it via the
// trailing _t aliases below.
template <typename __F>
using invoke_herbceptions_return_failure_result_t =
    __invoke_herbceptions_return_failure_result<__F>;

template <typename __F>
using invoke_herbceptions_return_failure_value_t =
    typename ::std::invoke_herbceptions_return_failure_result_t<
        __F>::value_type;

template <typename __F>
using invoke_herbceptions_return_failure_error_t =
    typename ::std::invoke_herbceptions_return_failure_result_t<
        __F>::error_type;

// Whether a type's throws-constructible/assignable/convertible operations can
// propagate a herbception error through the `throws` channel.
template <typename __T, typename... __A>
inline constexpr bool is_herbceptions_throws_constructible_v =
    __is_herbceptions_throws_constructible(__T, __A...);

