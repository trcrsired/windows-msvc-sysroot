// Cannot be forward-declared: MSVC STL puts type_info in the global
// namespace and imports it into std via a using-declaration.
#include <typeinfo>

/*
Feature detection. Plain MSVC defines __cpp_rtti/__cpp_exceptions even when
the switches are off, so there the STL's _HAS_RTTI/_HAS_EXCEPTIONS settings
are the real signal; clang's __cpp_* spellings are already accurate on every
target (including clang-cl).
*/
#pragma push_macro("_LIBHERBCEPTIONS_CPP_RTTI")
#undef _LIBHERBCEPTIONS_CPP_RTTI
#if defined(_MSC_VER) && !defined(__clang__)
#if __cpp_rtti >= 199711L && _HAS_RTTI
#define _LIBHERBCEPTIONS_CPP_RTTI
#endif
#else
#if __cpp_rtti >= 199711L
#define _LIBHERBCEPTIONS_CPP_RTTI
#endif
#endif

#pragma push_macro("_LIBHERBCEPTIONS_CPP_EXCEPTIONS")
#undef _LIBHERBCEPTIONS_CPP_EXCEPTIONS
#if defined(_MSC_VER) && !defined(__clang__)
#if __cpp_exceptions >= 199711L && _HAS_EXCEPTIONS
#define _LIBHERBCEPTIONS_CPP_EXCEPTIONS
#endif
#else
#if __cpp_exceptions >= 199711L
#define _LIBHERBCEPTIONS_CPP_EXCEPTIONS
#endif
#endif

/*
std::exception_ptr is a library, not language, feature: it exists
unconditionally on libstdc++ and libc++ even under -fno-exceptions, and only
the MSVC STL removes it (with the rest of the EH machinery) under
_HAS_EXCEPTIONS=0.
*/
#pragma push_macro("_LIBHERBCEPTIONS_STL_EXCEPTION_PTR")
#undef _LIBHERBCEPTIONS_STL_EXCEPTION_PTR
#if !defined(_MSVC_STL_UPDATE) || _HAS_EXCEPTIONS
#define _LIBHERBCEPTIONS_STL_EXCEPTION_PTR
#endif

namespace std {

class error;

struct io_scatter_t {
  void const *base;
  ::std::size_t len;
};
enum class error_reporter_encoding : ::std::uint_least32_t {
  utf8,
  utf16,
  utf32,
  gb18030,
  utfebcdic
};

using error_reporter_io_cookie_function = void (*)(void *,
                                                   ::std::io_scatter_t const *,
                                                   ::std::size_t) noexcept;

enum class error_query_information : ::std::uint_least32_t {
  name = 1,
  message = 2,
  name_message = 3
};
/*
Add an abi enum class to ensure user cross
windows-gnu/windows-msvc eh thrown correctness
*/
enum class legacy_exception_abi : ::std::uint_least32_t {
  itanium = 0,
  microsoft = 1,
#if defined(_MSC_VER)
  platform = microsoft
#else
  platform = itanium
#endif
};
struct error_domain_singleton {
  void (*do_cleanup)(::std::size_t) noexcept = nullptr;
  bool (*do_equivalent)(::std::size_t, ::std::error_domain_singleton const *,
                        ::std::size_t) noexcept = nullptr;
  void (*do_query_information)(
      ::std::size_t, ::std::error_query_information,
      ::std::error_reporter_encoding, void *,
      ::std::error_reporter_io_cookie_function) noexcept = nullptr;
  ::std::errc (*do_to_errc)(::std::size_t) noexcept = nullptr;
  void (*do_throw_legacy_exception)(::std::size_t,
                                    ::std::legacy_exception_abi) = nullptr;
};

/*
 * Basic validity check for a domain table: do_equivalent, do_query_information
 * and do_to_errc are the hooks every domain must provide. do_cleanup and
 * do_throw_legacy_exception are optional, so a null pointer there is fine.
 * constexpr, so a constexpr domain table can be validated in a static_assert.
 */
[[nodiscard]] constexpr bool is_valid_error_domain_singleton(
    ::std::error_domain_singleton const &__singleton) noexcept {
  return __singleton.do_equivalent != nullptr &&
         __singleton.do_query_information != nullptr &&
         __singleton.do_to_errc != nullptr;
}
[[nodiscard]] constexpr bool is_valid_error_domain_singleton(
    ::std::error_domain_singleton const *__singleton) noexcept {
  return __singleton != nullptr &&
         is_valid_error_domain_singleton(*__singleton);
}

/*
 * The C ABI twin of std::error: exactly {domain pointer, code} — two words,
 * which is what the herbceptions error channel carries. The compiler
 * recognizes any struct tagged 'herbceptions_cxx_std_error' with this layout
 * and can throw it through `throw throws` directly, without going through
 * error_domain<T>. This is the type extern "C" (and plain C) functions
 * fabricate, and what std::error::release() hands ownership out through.
 */
#if defined(__CXX_STD_ERROR_TYPE__)
// The compiler injects the canonical error-channel type itself under
// -fherbceptions; alias it so std::cxx_std_error names the same record the
// ABI carries, no matter which header (or none) a TU saw. The name does not
// exist otherwise — a compiler without herbceptions has nothing for this
// struct to mean.
using cxx_std_error = __CXX_STD_ERROR_TYPE__;
#endif

namespace __details {
template <typename __T>
concept __error_domain_has_domain_alias_type =
    requires() { typename __T::domain_alias_type; };
} // namespace __details
// The error_domain customization point. It is declared but not defined: only
// specializations exist. T need not be an enum — any type with an
// error_domain<T> specialization can be thrown via `throw throws`.
template <typename __T> class error_domain;

// std::error is defined by the standard library, but it is not a type users
// can create, copy, or store. The compiler is the only manufacturer: for
// `throw throws e;` it evaluates error_domain<T>::domain() and
// error_domain<T>::code(e) and fabricates the {domain, code} value.
// Consequently:
//   - the default constructor is deleted;
//   - copy/move constructors and assignments are all deleted;
//   - there is only a destructor and helper methods;
//   - all data members are private.
class error {
public:
  error() = delete;
  error(error const &) = delete;
  error(error &&) = delete;
  error &operator=(error const &) = delete;
  error &operator=(error &&) = delete;

#if defined(__CXX_STD_ERROR_TYPE__)
  // Transfers ownership of the {domain, code} payload to the caller (e.g.
  // across an await/completion boundary) and rebinds *this to {posix domain,
  // 0}, the success value, so the destructor has nothing left to clean up.
  // Only exists when the compiler provides __cxx_std_error: std::error
  // values are fabricated by the compiler, so there is nothing to release
  // otherwise.
  // constexpr: error_domain<errc>::domain() is intercepted by the constant
  // evaluator, so release() works during constant evaluation too.
  [[nodiscard]] constexpr auto release() noexcept -> ::std::cxx_std_error;
#endif

  constexpr ~error() noexcept {
    // The domain is never null: error_domain<E>::domain() == nullptr is a
    // compile-time error at the throw site, and a __cxx_std_error with a
    // null domain must never be placed on the channel (its null state
    // means "no error", checked before throwing — it is not a std::error).
#if __has_cpp_attribute(assume)
    [[assume(__domain_opaque != nullptr)]];
#endif
    auto __docleanup{__domain_opaque->do_cleanup};
    if (__docleanup) {
      __docleanup(__code_opaque);
    }
  }
#if __has_cpp_attribute(__gnu__::__returns_nonnull__)
  [[__gnu__::__returns_nonnull__]]
#endif
  [[nodiscard]] constexpr ::std::error_domain_singleton const *
  domain() const noexcept {
    return __domain_opaque;
  }
  [[nodiscard]] constexpr __SIZE_TYPE__ code() const noexcept {
    return __code_opaque;
  }

  template <typename __Other>
    requires(::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
  constexpr bool equivalent(__Other __ec) const noexcept {
    using __other_error_domain_type = ::std::error_domain<__Other>;
    if constexpr (::std::__details::__error_domain_has_domain_alias_type<
                      __other_error_domain_type>) {
      using __domain_alias_type =
          typename __other_error_domain_type::domain_alias_type;
      return __domain_opaque->do_equivalent(
          __code_opaque, __domain_alias_type::domain(),
          __other_error_domain_type::code(__ec));
    } else {
      return __domain_opaque->do_equivalent(
          __code_opaque, __other_error_domain_type::domain(),
          __other_error_domain_type::code(__ec));
    }
  }
  [[nodiscard]] constexpr ::std::errc to_errc() const noexcept {
    return __domain_opaque->do_to_errc(__code_opaque);
  }

  // Defined out-of-line after __details/legacy_exception.h: the fallback
  // boxes the {domain, code} pair into std::cxx_std_error_legacy_exception,
  // which must be complete first.
  [[noreturn]] void throw_legacy_exception() const
#if defined(_LIBHERBCEPTIONS_CPP_EXCEPTIONS)
      ;
#else
  // With EH disabled there is no mechanism to raise the legacy exception,
  // so the call is ill-formed at compile time instead of terminating
  // (P1105R0 only covers `throw`, whose termination is defined).
#if defined(__cpp_deleted_function) && __cpp_deleted_function >= 202403L
      = delete ("std::error::throw_legacy_exception requires C++ legacy "
                "exception handling; this translation unit is built with "
                "C++ legacy exceptions disabled (-fno-exceptions)");
#else
      = delete;
#endif
#endif
  template <typename __Other>
    requires(::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
  inline constexpr bool is_code_of() const noexcept {
    using __other_error_domain_type = ::std::error_domain<__Other>;
    if constexpr (::std::__details::__error_domain_has_domain_alias_type<
                      __other_error_domain_type>) {
      using __domain_alias_type =
          typename __other_error_domain_type::domain_alias_type;
      return __domain_alias_type::domain() == __domain_opaque;
    } else {
      return __other_error_domain_type::domain() == __domain_opaque;
    }
  }

private:
  // The {domain, code} payload, laid out as exactly two words so the value
  // flows through the {void*, size_t} ABI slot unchanged.
  ::std::error_domain_singleton const *__domain_opaque{};
  __SIZE_TYPE__ __code_opaque{};
};

static_assert(sizeof(::std::error) == 2 * sizeof(void *),
              "std::error must be exactly two pointers in size");
static_assert(alignof(::std::error) == alignof(void *),
              "std::error alignment must match pointer alignment");

