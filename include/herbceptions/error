/*
Herbception error core types.

std::errc comes from <system_error> (C++23 makes the errc part freestanding in
libc++, so this also works under -ffreestanding). The {domain, code} ABI slot
and the do_to_errc signature use the standard std::errc type.
*/

// Prevent macro pollution from Windows headers and from the <system_error>
// include: save and undef common macros so they cannot break this header or
// the types defined here. They are restored at the end of the header.
#pragma push_macro("min")
#undef min
#pragma push_macro("max")
#undef max
#pragma push_macro("new")
#undef new
#pragma push_macro("interface")
#undef interface
#pragma push_macro("refresh")
#undef refresh
#pragma push_macro("move")
