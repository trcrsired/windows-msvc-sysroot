namespace std {
#if defined(__CXX_STD_ERROR_TYPE__)
// Transfers ownership of the {domain, code} payload to the caller and
// rebinds *this to {posix domain, 0} — the success value.
// Defined here, after the __details domain headers, because it needs the
// error_domain<std::errc> specialization: binding through
// error_domain<errc>::domain() is what lets this run in constant
// evaluation — the constexpr evaluator intercepts the call and fabricates
// a unique opaque domain; at runtime it resolves to the real
// __cxa_error_domain_posix() singleton.
constexpr auto error::release() noexcept -> ::std::cxx_std_error {
  ::std::cxx_std_error __ec{__domain_opaque, __code_opaque};
  __domain_opaque = ::std::error_domain<::std::errc>::domain();
  __code_opaque = 0;
#if __has_cpp_attribute(assume)
  if !consteval {
    // The rebound domain has no cleanup hook; publishing that here lets the
    // optimizer collapse the destructor of a released error when inlined.
    [[assume(__domain_opaque->do_cleanup == nullptr)]];
  }
#endif
  return __ec;
}
#endif

#if defined(_LIBHERBCEPTIONS_CPP_EXCEPTIONS)
// Defined here, after __details/legacy_exception.h, because the fallback
// throw needs the complete cxx_std_error_legacy_exception type.
inline void error::throw_legacy_exception() const {
  auto __dothrow{__domain_opaque->do_throw_legacy_exception};
  if (__dothrow) {
    // If the function returns then the EH was not thrown for whatever
    // reason; fall back to boxing the {domain, code} pair below.
    __dothrow(static_cast<::std::size_t>(this->code()),
              ::std::legacy_exception_abi::platform);
  }
  // The std::error in the catch clause keeps ownership of its code and
  // runs do_cleanup while the box unwinds past it, so the box borrows the
  // pair (original-domain message, posix-demoted payload) instead of
  // taking ownership.
  throw ::std::cxx_std_error_legacy_exception(
      ::std::cxx_std_error_legacy_exception::__borrowed_t{}, __domain_opaque,
      static_cast<::std::size_t>(__code_opaque));
}
#endif
